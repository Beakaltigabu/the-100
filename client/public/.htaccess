# THE 100 — SPA fallback + hardening (cPanel/Apache)
# Serve index.html for any route so client-side routing works on direct URLs
# (/admin, /login, /profile, hard refreshes). The API lives on a subdomain
# (api.chooseyour100.com), so this host only serves the built app.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical domain: apex chooseyour100.com. Force www -> apex so Google OAuth
  # callbacks, cookies and localStorage all live on a single origin.
  RewriteCond %{HTTP_HOST} ^www\.chooseyour100\.com$ [NC]
  RewriteRule ^(.*)$ https://chooseyour100.com/$1 [L,R=301]

  # Mark Vite's content-hashed build assets for immutable caching (header set below)
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [E=CACHE_IMMUTABLE:1]

  # Do not rewrite existing files (assets, images, fonts) or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Everything else goes to the SPA
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers (the CSP itself is a meta tag injected at build time)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed assets never change content — cache them forever
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE

  # The HTML shell, service worker and manifest must always revalidate so
  # deploys and SW updates reach users immediately. SEO/AI discovery files are
  # also kept fresh so search and answer engines pick up changes quickly.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|registerSW\.js|robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
