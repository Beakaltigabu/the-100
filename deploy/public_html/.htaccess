# THE 100 SPA — public_html (chooseyour100.com)
# SPA fallback + cache headers so users always get the newest build.
RewriteEngine On
RewriteBase /

# SPA fallback (don't touch real files; there is no /api here)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]

# Revalidate the entry points every load -> index.html always points at the
# newest hashed assets, sw.js always updates, and the manifest is fresh.
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Content-hashed build assets are immutable (safe to cache for a year).
<FilesMatch "\.(js|css|svg|png|ico|woff2|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>