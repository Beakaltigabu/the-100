# THE 100 - server environment template.
# Copy to server/.env and fill in real values. NEVER commit real secrets.

# App
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:4000
# Host app in the canonical campaign timezone (defaults to Africa/Addis_Ababa)
APP_TIMEZONE=Africa/Addis_Ababa
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=64-hex-characters-for-aes-256-gcm
COOKIE_SECURE=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=the100
DB_POOL_MAX=5
# Run knex migrations automatically on boot (safe with AUTO_MIGRATE=false too)
AUTO_MIGRATE=false

# --- Integrations ----------------------------------------------------------

# Strava (OAuth + webhooks). Webhook subscription auto-renews in the scheduler.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_REDIRECT_URI=http://localhost:4000/api/integrations/strava/callback

# Telegram bot (link flow + admin alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
TELEGRAM_GROUP_LINK=
# Comma-separated numeric Telegram ids that receive admin alerts (optional)
TELEGRAM_ADMIN_ID=

# Google OAuth (optional login method)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Email (optional password reset delivery) ------------------------------
# Password-recovery links are emailed when SMTP is configured, AND still sent to
# Telegram when the member linked the bot. Leave SMTP_* empty to keep the
# Telegram-only fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=THE 100 <no-reply@your-domain.com>

# --- Web Push (VAPID) ------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Admin / ops -----------------------------------------------------------
# Guard for the health/db-test/reach probe endpoints
ADMIN_PROBE_SECRET=
# Admin account email used by maintenance scripts
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Log retention (days) and hard caps
LOG_RETENTION_DAYS=14
LOG_ERROR_RETENTION_DAYS=30
LOG_MAX_ROWS=100000